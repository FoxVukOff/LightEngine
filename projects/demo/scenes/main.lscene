      "type": "Area",
      "name": "player",
      "script": "# игрок: стрелки или wasd, пробел - прыжок\non_start:\n    self.say(\"player ready\")\n\non_update(dt):\n    let dir = input.axis()\n    self.vel = dir * 320\n    if input.pressed(\"space\"):\n        self.vel.y = -430\n    if dir:\n        self.angle = lerp_angle(self.angle, dir.angle(), 0.25)\n        self.find(\"body\").flip_x = dir.x < 0\n    if self.pos.y > 420:\n        self.pos.y = 420\n        self.vel.y = 0\n",
